{
  "name": "backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend - fully edge-native with Hono.js and Drizzle ORM",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:create": "wrangler d1 create fullstack-db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply fullstack-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply fullstack-db --remote",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "drizzle-orm": "^0.29.0",
    "zod": "^3.22.0",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "drizzle-kit": "^0.20.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "wrangler": "^3.19.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}