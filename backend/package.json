{
  "name": "backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend - fully edge-native with Hono.js and Drizzle ORM",
  "main": "src/index.ts",
  "scripts": {
    "dev": "miniflare src/index.ts --watch --modules --compatibility-date=2024-12-21 --env-path .dev.vars --d1 DB --d1-persist .mf/d1 --kv KV --kv-persist .mf/kv --r2 BUCKET --r2-persist .mf/r2 --port 8787",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:create": "wrangler d1 create edge-native-db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply edge-native-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply edge-native-db --remote",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist .wrangler .mf"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "drizzle-orm": "^0.29.0",
    "jose": "^5.10.0",
    "zod": "^3.22.0",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "drizzle-kit": "^0.20.0",
    "eslint": "^8.55.0",
    "miniflare": "^3.20231218.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "wrangler": "^3.19.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}