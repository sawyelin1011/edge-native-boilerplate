# Local development environment variables (loaded by Miniflare via --env-path)
# These values are safe for local use only.

ENVIRONMENT=development
LOG_LEVEL=debug

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=true

# Auth
JWT_SECRET=dev-jwt-secret-please-change-before-production-32chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Sessions (KV)
SESSION_SECRET=dev-session-secret-please-change-before-production-32chars
SESSION_ENABLED=true
SESSION_COOKIE_NAME=sid
SESSION_TTL_SECONDS=604800
SESSION_ROTATE_EVERY_SECONDS=86400

# Rate limiting (KV)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Optional storage module (R2)
STORAGE_ENABLED=false
