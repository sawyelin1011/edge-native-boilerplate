{
  "name": "api",
  "version": "1.0.0",
  "description": "GSMFlow API - Edge-native backend with Hono + tRPC",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "@gsmflow/core": "workspace:*",
    "@gsmflow/trpc-contracts": "workspace:*",
    "@gsmflow/adapters-base": "workspace:*",
    "@gsmflow/adapters-cloudflare": "workspace:*",
    "@gsmflow/adapters-vercel-edge": "workspace:*",
    "@gsmflow/adapters-deno": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "typescript": "^5.3.0",
    "wrangler": "^3.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
